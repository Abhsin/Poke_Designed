{
  "name": "poke-electron-app",
  "version": "1.0.0",
  "description": "Poke Electron App based on Figma design",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never"
  },
  "keywords": [
    "electron",
    "poke",
    "desktop-app"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "sharp": "^0.34.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "openai": "^5.11.0",
    "tailwindcss": "^3.4.0",
    "tesseract.js": "^6.0.1"
  },
  "build": {
    "appId": "com.poke.app",
    "productName": "Poke",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "preload.js",
      "main-window.html",
      "main-window-renderer.js",
      "api-keys.html",
      "api-keys-renderer.js"
    ],
    "icon": "assets/icons/icon-512.png",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icons/icon-512.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon-256.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon-512.png"
    }
  }
}
